include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointApi.cmake")
get_target_property(_deposit_added gvdb_nvrhi_api GVDB_DEPOSIT_API_ADDED)
if(NOT _deposit_added)
    set_property(TARGET gvdb_nvrhi_api PROPERTY GVDB_DEPOSIT_API_ADDED TRUE)
    target_sources(gvdb_nvrhi_api PRIVATE "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiDepositApi.cpp")
    if(COMMAND ethereal_compile_shaders)
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point-deposit.cfg"
            CONTENT "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPointDeposit.slang\" -T cs -E depositOwnedPoints\n" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_point_deposit_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point-deposit.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_deposit")
    endif()
    if(GVDB_NVRHI_BUILD_API_TESTS)
        add_executable(gvdb_nvrhi_deposit_api_abi_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiDepositApiAbiTests.cpp")
        target_link_libraries(gvdb_nvrhi_deposit_api_abi_tests PRIVATE gvdb::nvrhi_api)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_deposit_api_abi_tests PRIVATE /utf-8)
        endif()
        add_test(NAME gvdb_nvrhi_deposit_api_abi COMMAND gvdb_nvrhi_deposit_api_abi_tests)
        set_tests_properties(gvdb_nvrhi_deposit_api_abi PROPERTIES TIMEOUT 30
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
    endif()
    if(GVDB_NVRHI_INSTALL)
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiDepositApi.md" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiDepositApi.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPointDeposit.slang" DESTINATION "${CMAKE_INSTALL_DATADIR}/gvdb/shaders")
    endif()
endif()
if( GVDB_NVRHI_BUILD_API_TESTS AND NOT TARGET gvdb_nvrhi_deposit_api_tests
        AND TARGET donut_app AND TARGET gvdb_point_deposit_shaders
        AND TARGET gvdb_nvrhi_owner_shaders AND TARGET gvdb_point_stream_shaders)
    add_executable(gvdb_nvrhi_deposit_api_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiDepositApiTests.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPortableData.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPortableVbx.cpp")
    target_link_libraries(gvdb_nvrhi_deposit_api_tests PRIVATE gvdb::nvrhi_api donut_app ShaderToolArtifacts)
    add_dependencies(gvdb_nvrhi_deposit_api_tests gvdb_point_deposit_shaders gvdb_nvrhi_owner_shaders gvdb_point_stream_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_deposit_api_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_deposit_api_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_deposit_api_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_deposit_api_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_gvdb_deposit_api_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_gvdb_deposit_api_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_gvdb_deposit_api_argument -dx12)
            else()
                set(_gvdb_deposit_api_argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_deposit_api_${api} COMMAND gvdb_nvrhi_deposit_api_tests ${_gvdb_deposit_api_argument})
            set_tests_properties(gvdb_nvrhi_deposit_api_${api} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        endif()
    endforeach()
    unset(_gvdb_deposit_api_argument)
endif()
unset(_deposit_added)
