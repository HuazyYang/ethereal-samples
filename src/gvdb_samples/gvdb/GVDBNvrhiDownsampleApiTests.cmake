# Independent public GPU fixture; the production module owns its ABI test.
if(GVDB_NVRHI_BUILD_API_TESTS AND NOT TARGET gvdb_nvrhi_downsample_api_tests
        AND TARGET donut_app AND TARGET gvdb_nvrhi_downsample_shaders AND TARGET ShaderToolArtifacts)
    add_executable(gvdb_nvrhi_downsample_api_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiDownsampleApiTests.cpp")
    target_link_libraries(gvdb_nvrhi_downsample_api_tests PRIVATE gvdb::nvrhi_api donut_app ShaderToolArtifacts)
    add_dependencies(gvdb_nvrhi_downsample_api_tests gvdb_nvrhi_downsample_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_downsample_api_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_downsample_api_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_downsample_api_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_downsample_api_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_downsample_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_downsample_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_downsample_argument -dx12)
            else()
                set(_downsample_argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_downsample_api_${api} COMMAND gvdb_nvrhi_downsample_api_tests ${_downsample_argument})
            set_tests_properties(gvdb_nvrhi_downsample_api_${api} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        endif()
    endforeach()
    unset(_downsample_argument)
endif()
