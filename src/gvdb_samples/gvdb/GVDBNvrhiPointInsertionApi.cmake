include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiSubcellApi.cmake")
get_target_property(_insertion_added gvdb_nvrhi_api GVDB_INSERTION_API_ADDED)
if(NOT _insertion_added)
    set_property(TARGET gvdb_nvrhi_api PROPERTY GVDB_INSERTION_API_ADDED TRUE)
    if(GVDB_NVRHI_BUILD_API_TESTS)
        add_executable(gvdb_nvrhi_point_insertion_api_abi_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiPointInsertionApiAbiTests.cpp")
        target_link_libraries(gvdb_nvrhi_point_insertion_api_abi_tests PRIVATE gvdb::nvrhi_api)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_point_insertion_api_abi_tests PRIVATE /utf-8)
        endif()
        add_test(NAME gvdb_nvrhi_point_insertion_api_abi COMMAND gvdb_nvrhi_point_insertion_api_abi_tests)
        set_tests_properties(gvdb_nvrhi_point_insertion_api_abi PROPERTIES TIMEOUT 30
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
    endif()
endif()
unset(_insertion_added)

if(GVDB_NVRHI_BUILD_API_TESTS AND TARGET donut_app AND TARGET gvdb_subcell_shaders AND NOT TARGET gvdb_nvrhi_point_insertion_tests)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointQuantizeApi.cmake")
    add_executable(gvdb_nvrhi_point_insertion_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiPointInsertionApiTests.cpp")
    target_link_libraries(gvdb_nvrhi_point_insertion_tests PRIVATE gvdb::nvrhi_api donut_app ShaderToolArtifacts)
    add_dependencies(gvdb_nvrhi_point_insertion_tests gvdb_subcell_shaders gvdb_point_quantize_shaders gvdb_point_cloud_owned_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_point_insertion_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_point_insertion_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_point_insertion_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_point_insertion_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(argument -vk)
            elseif(api STREQUAL "DX11")
                set(argument -dx11)
            elseif(api STREQUAL "DX12")
                set(argument -dx12)
            else()
                set(argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_point_insertion_${api} COMMAND gvdb_nvrhi_point_insertion_tests ${argument})
            set_tests_properties(gvdb_nvrhi_point_insertion_${api} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        endif()
    endforeach()
endif()
