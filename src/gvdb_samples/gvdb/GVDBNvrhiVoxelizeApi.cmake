include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiApi.cmake")
get_target_property(_gvdb_voxelize_api_added gvdb_nvrhi_api GVDB_VOXELIZE_API_ADDED)
if(NOT _gvdb_voxelize_api_added)
    set_property(TARGET gvdb_nvrhi_api PROPERTY GVDB_VOXELIZE_API_ADDED TRUE)
    target_sources(gvdb_nvrhi_api PRIVATE "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelizeApi.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelizeApi.h")
    if(COMMAND ethereal_compile_shaders)
        set(_voxelize_config "")
        foreach(entry clearTriangleBins countTriangleBins scatterTriangleBins solidVoxelize)
            string(APPEND _voxelize_config "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBMeshVoxelize.slang\" -T cs -E ${entry}\n")
        endforeach()
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-voxelize.cfg" CONTENT "${_voxelize_config}" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_nvrhi_voxelize_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-voxelize.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_voxelize")
        unset(_voxelize_config)
    endif()
    if(GVDB_NVRHI_BUILD_API_TESTS)
        add_executable(gvdb_nvrhi_voxelize_api_abi_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiVoxelizeApiAbiTests.cpp")
        target_link_libraries(gvdb_nvrhi_voxelize_api_abi_tests PRIVATE gvdb::nvrhi_api)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_voxelize_api_abi_tests PRIVATE /utf-8)
        endif()
        add_test(NAME gvdb_nvrhi_voxelize_api_abi COMMAND gvdb_nvrhi_voxelize_api_abi_tests)
        set_tests_properties(gvdb_nvrhi_voxelize_api_abi PROPERTIES TIMEOUT 30
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
    endif()
    if(GVDB_NVRHI_INSTALL)
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelizeApi.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelizeApi.md" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBMeshVoxelize.slang" "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBVoxelizeDivision.slang" DESTINATION "${CMAKE_INSTALL_DATADIR}/gvdb/shaders")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelizeApiTests.cmake")
unset(_gvdb_voxelize_api_added)
