# Public-interface and independent VBX-parser integration tests.
option(GVDB_NVRHI_BUILD_SERIALIZER_GPU_TESTS "Build four-backend public VBX transaction tests" ${BUILD_TESTING})
if(GVDB_NVRHI_BUILD_SERIALIZER_GPU_TESTS AND NOT TARGET gvdb_nvrhi_serializer_tests)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiSerializer.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelApi.cmake")
    add_executable(gvdb_nvrhi_serializer_tests
        "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiSerializerTests.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPortableData.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPortableVbx.cpp")
    target_link_libraries(gvdb_nvrhi_serializer_tests PRIVATE gvdb::nvrhi_api donut_app)
    add_dependencies(gvdb_nvrhi_serializer_tests gvdb_nvrhi_owner_shaders gvdb_nvrhi_voxel_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_serializer_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_serializer_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_serializer_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_serializer_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_gvdb_serializer_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_gvdb_serializer_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_gvdb_serializer_argument -dx12)
            else()
                set(_gvdb_serializer_argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_serializer_${api} COMMAND gvdb_nvrhi_serializer_tests ${_gvdb_serializer_argument})
            add_test(NAME gvdb_nvrhi_serializer_asset_${api} COMMAND gvdb_nvrhi_serializer_tests ${_gvdb_serializer_argument}
                --asset "${CMAKE_CURRENT_LIST_DIR}/../samples/assets/explosion.vbx")
            set_tests_properties(gvdb_nvrhi_serializer_${api} gvdb_nvrhi_serializer_asset_${api} PROPERTIES TIMEOUT 180
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        endif()
    endforeach()
    unset(_gvdb_serializer_argument)
endif()
