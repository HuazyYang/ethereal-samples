# Private authenticated append fixture. No additional production library.
option(GVDB_NVRHI_BUILD_ACCUMULATION_TESTS "Build stable-ID accumulation fixtures" ${BUILD_TESTING})
if(GVDB_NVRHI_BUILD_ACCUMULATION_TESTS AND NOT TARGET gvdb_nvrhi_accumulation_tests)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVolume.cmake")
    if(NOT TARGET donut_app OR NOT TARGET gvdb_nvrhi_owner_shaders)
        message(FATAL_ERROR "Accumulation GPU tests require Donut and owner test artifacts")
    endif()
    add_executable(gvdb_nvrhi_accumulation_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiAccumulationTests.cpp")
    target_link_libraries(gvdb_nvrhi_accumulation_tests PRIVATE gvdb::nvrhi_volume donut_app)
    add_dependencies(gvdb_nvrhi_accumulation_tests gvdb_nvrhi_owner_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_accumulation_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_accumulation_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_accumulation_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_accumulation_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_gvdb_accum_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_gvdb_accum_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_gvdb_accum_argument -dx12)
            else()
                set(_gvdb_accum_argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_accumulation_${api} COMMAND gvdb_nvrhi_accumulation_tests ${_gvdb_accum_argument})
            set_tests_properties(gvdb_nvrhi_accumulation_${api} PROPERTIES TIMEOUT 120)
        endif()
    endforeach()
    unset(_gvdb_accum_argument)
endif()
