# Queryable M5 public API. Device backends and the offline remap artifact remain caller choices.
if(NOT TARGET gvdb_nvrhi_api)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVolume.cmake")
    option(GVDB_NVRHI_API_SHARED "Build the queryable GVDB API as a shared library" ${BUILD_SHARED_LIBS})
    if(GVDB_NVRHI_API_SHARED)
        set(_gvdb_api_type SHARED)
    else()
        set(_gvdb_api_type STATIC)
    endif()
    add_library(gvdb_nvrhi_api ${_gvdb_api_type}
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiApi.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiApi.h")
    add_library(gvdb::nvrhi_api ALIAS gvdb_nvrhi_api)
    target_compile_features(gvdb_nvrhi_api PUBLIC cxx_std_17)
    target_include_directories(gvdb_nvrhi_api PUBLIC
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}>"
        "$<INSTALL_INTERFACE:include/gvdb>")
    target_link_libraries(gvdb_nvrhi_api PUBLIC nvrhi PRIVATE gvdb::nvrhi_volume)
    set_target_properties(gvdb_nvrhi_api PROPERTIES
        EXPORT_NAME nvrhi_api CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    if(GVDB_NVRHI_API_SHARED)
        target_compile_definitions(gvdb_nvrhi_api PRIVATE GVDB_NVRHI_SHARED_LIBRARY_BUILD=1
            INTERFACE GVDB_NVRHI_SHARED_LIBRARY_INCLUDE=1)
        set_target_properties(gvdb_host_volume gvdb_nvrhi_volume PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
    if(MSVC)
        target_compile_options(gvdb_nvrhi_api PRIVATE /utf-8)
    endif()
    option(GVDB_NVRHI_BUILD_API_TESTS "Build the queryable GVDB public API fixtures" ${BUILD_TESTING})
    if(GVDB_NVRHI_BUILD_API_TESTS)
        add_executable(gvdb_nvrhi_api_abi_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiApiAbiTests.cpp")
        target_link_libraries(gvdb_nvrhi_api_abi_tests PRIVATE gvdb::nvrhi_api)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_api_abi_tests PRIVATE /utf-8)
        endif()
        add_test(NAME gvdb_nvrhi_api_abi COMMAND gvdb_nvrhi_api_abi_tests)
        set_tests_properties(gvdb_nvrhi_api_abi PROPERTIES TIMEOUT 30
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        if(TARGET donut_app AND TARGET gvdb_nvrhi_owner_shaders)
            add_executable(gvdb_nvrhi_api_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiApiTests.cpp")
            target_link_libraries(gvdb_nvrhi_api_tests PRIVATE gvdb::nvrhi_api donut_app)
            add_dependencies(gvdb_nvrhi_api_tests gvdb_nvrhi_owner_shaders)
            ethereal_use_agility_sdk(gvdb_nvrhi_api_tests)
            if(MSVC)
                target_compile_options(gvdb_nvrhi_api_tests PRIVATE /utf-8)
            endif()
            if(NVRHI_WITH_CUDA)
                target_link_libraries(gvdb_nvrhi_api_tests PRIVATE nvrhi::cuda)
                target_compile_definitions(gvdb_nvrhi_api_tests PRIVATE ETHEREAL_TEST_CUDA=1)
            endif()
            foreach(api DX11 DX12 VULKAN CUDA)
                if(NVRHI_WITH_${api})
                    if(api STREQUAL "VULKAN")
                        set(_gvdb_api_argument -vk)
                    elseif(api STREQUAL "DX11")
                        set(_gvdb_api_argument -dx11)
                    elseif(api STREQUAL "DX12")
                        set(_gvdb_api_argument -dx12)
                    else()
                        set(_gvdb_api_argument -cuda)
                    endif()
                    add_test(NAME gvdb_nvrhi_api_${api} COMMAND gvdb_nvrhi_api_tests ${_gvdb_api_argument})
                    set_tests_properties(gvdb_nvrhi_api_${api} PROPERTIES TIMEOUT 120
                        ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
                endif()
            endforeach()
        endif()
    endif()
    unset(_gvdb_api_type)
    unset(_gvdb_api_argument)
endif()

option(GVDB_NVRHI_INSTALL "Install the queryable GVDB SDK and CMake package" OFF)
if(GVDB_NVRHI_INSTALL)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiInstall.cmake")
endif()
