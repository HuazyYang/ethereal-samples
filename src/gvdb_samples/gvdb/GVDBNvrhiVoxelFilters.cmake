# SDK-free voxel preparation over the authenticated owner mutation path.
if(NOT TARGET gvdb_nvrhi_voxel_filters)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVolume.cmake")
    add_library(gvdb_nvrhi_voxel_filters STATIC
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelFilters.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelFilters.h")
    add_library(gvdb::nvrhi_voxel_filters ALIAS gvdb_nvrhi_voxel_filters)
    target_compile_features(gvdb_nvrhi_voxel_filters PUBLIC cxx_std_17)
    target_link_libraries(gvdb_nvrhi_voxel_filters PUBLIC gvdb::nvrhi_volume)
    target_include_directories(gvdb_nvrhi_voxel_filters PUBLIC
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}>"
        "$<INSTALL_INTERFACE:include/gvdb>")
    set_target_properties(gvdb_nvrhi_voxel_filters PROPERTIES EXPORT_NAME nvrhi_voxel_filters POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_voxel_filters PRIVATE /utf-8)
    endif()
    option(GVDB_NVRHI_BUILD_FILTER_TESTS "Build the four-backend owned voxel filter fixtures" ${BUILD_TESTING})
    if(GVDB_NVRHI_BUILD_FILTER_TESTS)
        if(NOT TARGET donut_app OR NOT TARGET gvdb_nvrhi_owner_shaders OR NOT COMMAND ethereal_compile_shaders)
            message(FATAL_ERROR "Voxel GPU tests require donut_app, owner test shaders and ethereal_compile_shaders; the library does not")
        endif()
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-filters.cfg"
            CONTENT "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBAtlasFilters.slang\" -T cs -E filterAtlas\n" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_nvrhi_filter_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-filters.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_filters"
            INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/slang")
        add_executable(gvdb_nvrhi_filter_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiVoxelFiltersTests.cpp")
        target_link_libraries(gvdb_nvrhi_filter_tests PRIVATE gvdb::nvrhi_voxel_filters donut_app ShaderTool::Artifacts)
        add_dependencies(gvdb_nvrhi_filter_tests gvdb_nvrhi_filter_shaders gvdb_nvrhi_owner_shaders)
        ethereal_use_agility_sdk(gvdb_nvrhi_filter_tests)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_filter_tests PRIVATE /utf-8)
        endif()
        if(NVRHI_WITH_CUDA)
            target_link_libraries(gvdb_nvrhi_filter_tests PRIVATE nvrhi::cuda)
            target_compile_definitions(gvdb_nvrhi_filter_tests PRIVATE ETHEREAL_TEST_CUDA=1)
        endif()
        foreach(api DX11 DX12 VULKAN CUDA)
            if(NVRHI_WITH_${api})
                if(api STREQUAL "VULKAN")
                    set(_gvdb_filter_argument -vk)
                elseif(api STREQUAL "DX11")
                    set(_gvdb_filter_argument -dx11)
                elseif(api STREQUAL "DX12")
                    set(_gvdb_filter_argument -dx12)
                else()
                    set(_gvdb_filter_argument -cuda)
                endif()
                add_test(NAME gvdb_nvrhi_filter_${api} COMMAND gvdb_nvrhi_filter_tests ${_gvdb_filter_argument})
                set_tests_properties(gvdb_nvrhi_filter_${api} PROPERTIES TIMEOUT 120)
            endif()
        endforeach()
        unset(_gvdb_filter_argument)
    endif()
endif()
