# Standalone raw point stream validator and optional four-backend shader fixtures.
if(NOT TARGET gvdb_point_stream_conversion)
    add_library(gvdb_point_stream_conversion STATIC
        "${CMAKE_CURRENT_LIST_DIR}/GVDBPointStreamConversion.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/GVDBPointStreamConversion.h")
    add_library(gvdb::point_stream_conversion ALIAS gvdb_point_stream_conversion)
    target_compile_features(gvdb_point_stream_conversion PUBLIC cxx_std_17)
    target_link_libraries(gvdb_point_stream_conversion PUBLIC nvrhi)
    target_include_directories(gvdb_point_stream_conversion PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    if(MSVC)
        target_compile_options(gvdb_point_stream_conversion PRIVATE /utf-8)
    endif()
    if(BUILD_TESTING AND TARGET gvdb_slang_runtime AND TARGET donut_app)
        set(_point_stream_cfg "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPointStreamConversion.slang\" -T cs -E convertPointStream\n")
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point-stream.cfg" CONTENT "${_point_stream_cfg}" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_point_stream_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point-stream.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_slang")
        add_executable(gvdb_point_stream_conversion_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBPointStreamConversionTests.cpp")
        target_link_libraries(gvdb_point_stream_conversion_tests PRIVATE gvdb::point_stream_conversion gvdb_slang_runtime donut_app)
        add_dependencies(gvdb_point_stream_conversion_tests gvdb_point_stream_shaders)
        ethereal_use_agility_sdk(gvdb_point_stream_conversion_tests)
        if(NVRHI_WITH_CUDA)
            target_link_libraries(gvdb_point_stream_conversion_tests PRIVATE nvrhi::cuda)
            target_compile_definitions(gvdb_point_stream_conversion_tests PRIVATE ETHEREAL_TEST_CUDA=1)
        endif()
        foreach(api DX11 DX12 VULKAN CUDA)
            if(NVRHI_WITH_${api})
                if(api STREQUAL "DX11")
                    set(_point_api -dx11)
                elseif(api STREQUAL "DX12")
                    set(_point_api -dx12)
                elseif(api STREQUAL "VULKAN")
                    set(_point_api -vk)
                else()
                    set(_point_api -cuda)
                endif()
                add_test(NAME gvdb_point_stream_conversion_${api} COMMAND gvdb_point_stream_conversion_tests ${_point_api})
                set_tests_properties(gvdb_point_stream_conversion_${api} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE)
            endif()
        endforeach()
    endif()
endif()
