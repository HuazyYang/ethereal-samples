# Independent private import-transaction fixture; no additional runtime library.
option(GVDB_NVRHI_BUILD_ADOPTION_TESTS "Build transactional host/atlas adoption fixtures" ${BUILD_TESTING})
if(GVDB_NVRHI_BUILD_ADOPTION_TESTS AND NOT TARGET gvdb_nvrhi_adoption_tests)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVoxelOps.cmake")
    if(NOT TARGET donut_app OR NOT TARGET gvdb_nvrhi_owner_shaders OR NOT TARGET gvdb_nvrhi_voxel_shaders)
        message(FATAL_ERROR "Adoption GPU tests require Donut and owner/voxel test artifacts")
    endif()
    add_executable(gvdb_nvrhi_adoption_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiAdoptionTests.cpp")
    target_link_libraries(gvdb_nvrhi_adoption_tests PRIVATE gvdb::nvrhi_voxel_ops donut_app)
    add_dependencies(gvdb_nvrhi_adoption_tests gvdb_nvrhi_owner_shaders gvdb_nvrhi_voxel_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_adoption_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_adoption_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_adoption_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_adoption_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_gvdb_adoption_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_gvdb_adoption_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_gvdb_adoption_argument -dx12)
            else()
                set(_gvdb_adoption_argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_adoption_${api} COMMAND gvdb_nvrhi_adoption_tests ${_gvdb_adoption_argument})
            set_tests_properties(gvdb_nvrhi_adoption_${api} PROPERTIES TIMEOUT 120)
        endif()
    endforeach()
    unset(_gvdb_adoption_argument)
endif()
