# Additive M5 owner. Public library needs only NVRHI and the CPU topology core.
if(NOT TARGET gvdb_nvrhi_volume)
    include("${CMAKE_CURRENT_LIST_DIR}/GVDBHostVolume.cmake")
    add_library(gvdb_nvrhi_volume STATIC
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVolume.cpp"
        "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiVolume.h")
    add_library(gvdb::nvrhi_volume ALIAS gvdb_nvrhi_volume)
    target_compile_features(gvdb_nvrhi_volume PUBLIC cxx_std_17)
    target_link_libraries(gvdb_nvrhi_volume PUBLIC gvdb::host_volume nvrhi)
    target_include_directories(gvdb_nvrhi_volume PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    if(MSVC)
        target_compile_options(gvdb_nvrhi_volume PRIVATE /utf-8)
    endif()
    option(GVDB_NVRHI_BUILD_OWNER_TESTS "Build the four-backend volume ownership fixtures" ${BUILD_TESTING})
    if(GVDB_NVRHI_BUILD_OWNER_TESTS)
        if(NOT TARGET donut_app OR NOT COMMAND ethereal_compile_shaders)
            message(FATAL_ERROR "Owner GPU tests require donut_app and ethereal_compile_shaders; the owner library does not")
        endif()
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owner.cfg"
            CONTENT "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBAtlasRepack.slang\" -T cs -E relocateAtlas\n" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_nvrhi_owner_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owner.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_owner"
            INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/slang")
        add_executable(gvdb_nvrhi_volume_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiVolumeTests.cpp")
        target_link_libraries(gvdb_nvrhi_volume_tests PRIVATE gvdb::nvrhi_volume donut_app ShaderTool::Artifacts)
        add_dependencies(gvdb_nvrhi_volume_tests gvdb_nvrhi_owner_shaders)
        ethereal_use_agility_sdk(gvdb_nvrhi_volume_tests)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_volume_tests PRIVATE /utf-8)
        endif()
        if(NVRHI_WITH_CUDA)
            target_link_libraries(gvdb_nvrhi_volume_tests PRIVATE nvrhi::cuda)
            target_compile_definitions(gvdb_nvrhi_volume_tests PRIVATE ETHEREAL_TEST_CUDA=1)
        endif()
        foreach(api DX11 DX12 VULKAN CUDA)
            if(NVRHI_WITH_${api})
                if(api STREQUAL "VULKAN")
                    set(argument -vk)
                elseif(api STREQUAL "DX11")
                    set(argument -dx11)
                elseif(api STREQUAL "DX12")
                    set(argument -dx12)
                else()
                    set(argument -cuda)
                endif()
                add_test(NAME gvdb_nvrhi_volume_${api} COMMAND gvdb_nvrhi_volume_tests ${argument})
                set_tests_properties(gvdb_nvrhi_volume_${api} PROPERTIES TIMEOUT 120)
            endif()
        endforeach()
    endif()
endif()
