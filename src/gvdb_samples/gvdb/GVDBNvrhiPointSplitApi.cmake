include("${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointApi.cmake")
get_target_property(_point_split_added gvdb_nvrhi_api GVDB_POINT_SPLIT_API_ADDED)
if(NOT _point_split_added)
    set_property(TARGET gvdb_nvrhi_api PROPERTY GVDB_POINT_SPLIT_API_ADDED TRUE)
    target_sources(gvdb_nvrhi_api PRIVATE "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointSplitApi.cpp")
    if(COMMAND ethereal_compile_shaders)
        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point_split.cfg" CONTENT
            "\"${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPointSplit.slang\" -T cs -E splitPointCoordinates\n" @ONLY)
        ethereal_compile_shaders(TARGET gvdb_point_split_shaders SLANG CUDA ALL_PLATFORMS
            CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-point_split.cfg"
            OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_point_split")
    endif()
    if(GVDB_NVRHI_INSTALL)
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointSplitApi.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/GVDBNvrhiPointSplitApi.md" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/gvdb")
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/slang/GVDBPointSplit.slang" DESTINATION "${CMAKE_INSTALL_DATADIR}/gvdb/shaders")
    endif()
    if(GVDB_NVRHI_BUILD_API_TESTS)
        add_executable(gvdb_nvrhi_point_split_api_abi_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiPointSplitApiAbiTests.cpp")
        target_link_libraries(gvdb_nvrhi_point_split_api_abi_tests PRIVATE gvdb::nvrhi_api)
        if(MSVC)
            target_compile_options(gvdb_nvrhi_point_split_api_abi_tests PRIVATE /utf-8)
        endif()
        add_test(NAME gvdb_nvrhi_point_split_api_abi COMMAND gvdb_nvrhi_point_split_api_abi_tests)
        set_tests_properties(gvdb_nvrhi_point_split_api_abi PROPERTIES TIMEOUT 30
            ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
    endif()
endif()
unset(_point_split_added)

if(GVDB_NVRHI_BUILD_API_TESTS AND TARGET donut_app AND TARGET gvdb_point_split_shaders AND NOT TARGET gvdb_nvrhi_point_split_tests)
    add_executable(gvdb_nvrhi_point_split_tests "${CMAKE_CURRENT_LIST_DIR}/tests/GVDBNvrhiPointSplitApiTests.cpp")
    target_link_libraries(gvdb_nvrhi_point_split_tests PRIVATE gvdb::nvrhi_api donut_app ShaderToolArtifacts)
    add_dependencies(gvdb_nvrhi_point_split_tests gvdb_point_split_shaders gvdb_point_cloud_owned_shaders)
    ethereal_use_agility_sdk(gvdb_nvrhi_point_split_tests)
    if(MSVC)
        target_compile_options(gvdb_nvrhi_point_split_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_nvrhi_point_split_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_nvrhi_point_split_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(argument -vk)
            elseif(api STREQUAL "DX11")
                set(argument -dx11)
            elseif(api STREQUAL "DX12")
                set(argument -dx12)
            else()
                set(argument -cuda)
            endif()
            add_test(NAME gvdb_nvrhi_point_split_${api} COMMAND gvdb_nvrhi_point_split_tests ${argument})
            set_tests_properties(gvdb_nvrhi_point_split_${api} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:gvdb_nvrhi_api>;PATH=path_list_prepend:$<TARGET_FILE_DIR:nvrhi_core>")
        endif()
    endforeach()
endif()
