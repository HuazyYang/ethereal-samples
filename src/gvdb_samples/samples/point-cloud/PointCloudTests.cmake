# Standalone input/reconstruction slice; legacy point-cloud application is unchanged.
set(point_cloud_dir "${CMAKE_CURRENT_LIST_DIR}")
set(point_cloud_assets "${point_cloud_dir}/../assets")
set(point_cloud_shader_config "")
foreach(entry decodeSubcellPoints publishPointCloudAtlas)
    string(APPEND point_cloud_shader_config "\"${point_cloud_dir}/PointCloudReconstruction.slang\" -T cs -E ${entry}\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/point-cloud-reconstruction.cfg" CONTENT "${point_cloud_shader_config}" @ONLY)
ethereal_compile_shaders(TARGET gvdb_point_cloud_shaders SLANG CUDA ALL_PLATFORMS
    CONFIG "${CMAKE_CURRENT_BINARY_DIR}/point-cloud-reconstruction.cfg"
    OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_slang")
add_library(gvdb_point_cloud_input STATIC "${point_cloud_dir}/PointCloudInput.cpp" "${point_cloud_dir}/PointCloudScene.cpp")
target_include_directories(gvdb_point_cloud_input PUBLIC "${point_cloud_dir}" "${point_cloud_dir}/../.." "${point_cloud_dir}/..")
target_link_libraries(gvdb_point_cloud_input PUBLIC donut_core)
add_library(gvdb_point_cloud_reconstruction STATIC "${point_cloud_dir}/PointCloudReconstruction.cpp")
target_link_libraries(gvdb_point_cloud_reconstruction PUBLIC gvdb_point_cloud_input gvdb_slang_runtime)
add_dependencies(gvdb_point_cloud_reconstruction gvdb_point_cloud_shaders gvdb_slang_shaders)
add_executable(gvdb_point_cloud_input_tests "${point_cloud_dir}/PointCloudInputTests.cpp")
target_link_libraries(gvdb_point_cloud_input_tests PRIVATE gvdb_point_cloud_input)
add_test(NAME gvdb_point_cloud_input COMMAND gvdb_point_cloud_input_tests "${point_cloud_assets}")
add_executable(gvdb_point_cloud_reconstruction_tests "${point_cloud_dir}/PointCloudReconstructionTests.cpp")
target_link_libraries(gvdb_point_cloud_reconstruction_tests PRIVATE gvdb_point_cloud_reconstruction donut_app)
ethereal_use_agility_sdk(gvdb_point_cloud_reconstruction_tests)
if(NVRHI_WITH_CUDA)
    target_link_libraries(gvdb_point_cloud_reconstruction_tests PRIVATE nvrhi::cuda)
    target_compile_definitions(gvdb_point_cloud_reconstruction_tests PRIVATE ETHEREAL_TEST_CUDA=1)
endif()
foreach(api DX11 DX12 VULKAN CUDA)
    if(NVRHI_WITH_${api})
        if(api STREQUAL "VULKAN")
            set(argument -vk)
        elseif(api STREQUAL "DX11")
            set(argument -dx11)
        elseif(api STREQUAL "DX12")
            set(argument -dx12)
        else()
            set(argument -cuda)
        endif()
        add_test(NAME gvdb_point_cloud_reconstruction_${api} COMMAND gvdb_point_cloud_reconstruction_tests ${argument})
        add_test(NAME gvdb_point_cloud_asset_${api} COMMAND gvdb_point_cloud_reconstruction_tests ${argument} --asset "${point_cloud_assets}")
        set_tests_properties(gvdb_point_cloud_reconstruction_${api} PROPERTIES TIMEOUT 120)
        set_tests_properties(gvdb_point_cloud_asset_${api} PROPERTIES TIMEOUT 600 RUN_SERIAL TRUE)
    endif()
endforeach()
