# Public snapshot level-set renderer. Production artifacts are independent of tests.
if(NOT TARGET gvdb_owned_surface)
    include("${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeRaycast.cmake")
    set(_owned_surface_dir "${CMAKE_CURRENT_LIST_DIR}/../../../slang_compute")
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owned-surface.cfg" CONTENT
        "\"${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSurface.slang\" -T cs -E renderSurface\n" @ONLY)
    ethereal_compile_shaders(TARGET gvdb_owned_surface_shaders SLANG CUDA ALL_PLATFORMS
        CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owned-surface.cfg"
        OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_owned"
        INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/../../gvdb/slang" "${_owned_surface_dir}")
    add_library(gvdb_owned_surface STATIC "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSurface.cpp")
    target_link_libraries(gvdb_owned_surface PUBLIC gvdb_owned_raycast)
    target_include_directories(gvdb_owned_surface PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    add_dependencies(gvdb_owned_surface gvdb_owned_surface_shaders)
    if(MSVC)
        target_compile_options(gvdb_owned_surface PRIVATE /utf-8)
    endif()
    # The standalone app helper does not force the optional viewer into consumers.
    if(BUILD_TESTING AND TARGET gvdb_volume_viewer AND TARGET gvdb_volume_surface)
        add_executable(gvdb_owned_surface_tests "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSurfaceTests.cpp")
        target_link_libraries(gvdb_owned_surface_tests PRIVATE gvdb_owned_surface gvdb_volume_viewer gvdb_volume_surface)
        ethereal_use_agility_sdk(gvdb_owned_surface_tests)
        if(NVRHI_WITH_CUDA)
            target_compile_definitions(gvdb_owned_surface_tests PRIVATE ETHEREAL_TEST_CUDA=1)
            target_link_libraries(gvdb_owned_surface_tests PRIVATE nvrhi::cuda)
        endif()
        foreach(api DX11 DX12 VULKAN CUDA)
            if(NVRHI_WITH_${api})
                if(api STREQUAL "VULKAN")
                    set(argument -vk)
                elseif(api STREQUAL "DX11")
                    set(argument -dx11)
                elseif(api STREQUAL "DX12")
                    set(argument -dx12)
                else()
                    set(argument -cuda)
                endif()
                add_test(NAME gvdb_owned_surface_${api} COMMAND gvdb_owned_surface_tests ${argument})
                set_tests_properties(gvdb_owned_surface_${api} PROPERTIES TIMEOUT 120)
            endif()
        endforeach()
    endif()
    unset(_owned_surface_dir)
endif()
