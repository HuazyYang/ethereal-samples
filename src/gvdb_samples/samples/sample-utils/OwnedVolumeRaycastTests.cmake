# Test-only comparisons keep the former portable scalar owner as an oracle.
if(BUILD_TESTING AND NOT TARGET gvdb_owned_raycast_tests)
    include("${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeRaycast.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../../gvdb/GVDBNvrhiVoxelApi.cmake")
    add_executable(gvdb_owned_raycast_tests "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeRaycastTests.cpp")
    target_link_libraries(gvdb_owned_raycast_tests PRIVATE gvdb_owned_raycast donut_app)
    target_compile_definitions(gvdb_owned_raycast_tests PRIVATE "GVDB_SAMPLES_ASSETS_DIR=\"${CMAKE_CURRENT_LIST_DIR}/../assets\"")
    add_dependencies(gvdb_owned_raycast_tests gvdb_owned_raycast_shaders gvdb_slang_shaders gvdb_nvrhi_voxel_shaders)
    ethereal_use_agility_sdk(gvdb_owned_raycast_tests)
    if(MSVC)
        target_compile_options(gvdb_owned_raycast_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_owned_raycast_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_owned_raycast_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(_owned_argument -vk)
            elseif(api STREQUAL "DX11")
                set(_owned_argument -dx11)
            elseif(api STREQUAL "DX12")
                set(_owned_argument -dx12)
            else()
                set(_owned_argument -cuda)
            endif()
            add_test(NAME gvdb_owned_raycast_${api} COMMAND gvdb_owned_raycast_tests ${_owned_argument})
            set_tests_properties(gvdb_owned_raycast_${api} PROPERTIES TIMEOUT 180)
        endif()
    endforeach()
    unset(_owned_argument)
endif()
