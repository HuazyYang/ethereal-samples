include("${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeRaycast.cmake")
if(NOT TARGET gvdb_owned_sections)
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owned-sections.cfg" CONTENT
        "\"${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSections.slang\" -T cs -E renderSection\n\"${CMAKE_CURRENT_LIST_DIR}/CompositeOver.slang\" -T cs -E compositeOver\n" @ONLY)
    ethereal_compile_shaders(TARGET gvdb_owned_sections_shaders SLANG CUDA ALL_PLATFORMS
        CONFIG "${CMAKE_CURRENT_BINARY_DIR}/gvdb-owned-sections.cfg"
        OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/gvdb_owned")
    add_library(gvdb_owned_sections STATIC "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSections.cpp")
    target_link_libraries(gvdb_owned_sections PUBLIC gvdb_owned_raycast)
    add_dependencies(gvdb_owned_sections gvdb_owned_sections_shaders)
    if(MSVC)
        target_compile_options(gvdb_owned_sections PRIVATE /utf-8)
    endif()
endif()
if(BUILD_TESTING AND NOT TARGET gvdb_owned_sections_tests)
    add_executable(gvdb_owned_sections_tests "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeSectionsTests.cpp")
    target_link_libraries(gvdb_owned_sections_tests PRIVATE gvdb_owned_sections donut_app)
    ethereal_use_agility_sdk(gvdb_owned_sections_tests)
    if(MSVC)
        target_compile_options(gvdb_owned_sections_tests PRIVATE /utf-8)
    endif()
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_owned_sections_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_owned_sections_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(argument -vk)
            elseif(api STREQUAL "DX11")
                set(argument -dx11)
            elseif(api STREQUAL "DX12")
                set(argument -dx12)
            else()
                set(argument -cuda)
            endif()
            add_test(NAME gvdb_owned_sections_${api} COMMAND gvdb_owned_sections_tests ${argument})
            set_tests_properties(gvdb_owned_sections_${api} PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
        endif()
    endforeach()
endif()
