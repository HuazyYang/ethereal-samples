// The scene of the GVDB raycaster (port of cuda_gvdb_scene.cuh): the shading
// modes, the ScnInfo block a render kernel gets (as a pointer argument; the
// reference had it as the `scn` constant) and the ScnRay records of
// VolRenderer::raytrace. Same layouts as the host mirrors in VolRenderer.cpp.
#pragma once

// Scene shading modes (gvdb::VolumeShading)
#define SHADE_VOXEL     0
#define SHADE_SECTION2D 1
#define SHADE_SECTION3D 2
#define SHADE_EMPTYSKIP 3
#define SHADE_TRILINEAR 4
#define SHADE_TRICUBIC  5
#define SHADE_LEVELSET  6
#define SHADE_VOLUME    7

static const float NOHIT = 1.0e10f;

struct ScnInfo
{
    int         width;
    int         height;
    float       camnear;
    float       camfar;
    float3      campos;
    float3      cams;          // direction through the top-left corner of the image
    float3      camu;          // per image width
    float3      camv;          // per image height
    float3      light_pos;     // index space
    float3      slice_pnt;
    float3      slice_norm;
    float3      shadow_params; // shadow amount, shadow bias
    float4      backclr;
    float       xform[16];     // index -> world (row vectors, mmult)
    float       invxform[16];  // world -> index
    float       invxrot[16];   // world -> index directions
    float       bias;
    int8_t      shading;
    int8_t      filtering;
    int         frame;
    int         samples;
    float3      extinct;       // extinction, albedo
    float3      steps;         // direct step, shadow step, fine step
    float3      cutoff;        // minimum value, alpha cut-off
    float3      thresh;        // iso value, value min, value max
    float       epsilon;
    int         gvdb_channel;  // RGBA8 colour channel or CHAN_UNDEF
    float4*     transfer;      // transfer function (TRANSFER_FUNC_SIZE entries)
    uint8_t*    outbuf;
    float*      dbuf;          // depth buffer (post-projection depth per pixel) or null
};

struct ScnRay
{
    float3      hit;
    float3      normal;
    float3      orig;
    float3      dir;
    uint        clr;
    uint        pnode;
    uint        pndx;
    uint        pad;           // 64 bytes, as the __align__(16) struct of the reference (rays are an array)
};

// mmult of the reference: (mtx[12..14]) + vec * the 3x3 of a row-vector 4x4 matrix of 16 floats.
float3 mmult(float mtx[16], float3 vec)
{
    return float3(vec.x * mtx[0] + vec.y * mtx[4] + vec.z * mtx[8] + mtx[12],
                  vec.x * mtx[1] + vec.y * mtx[5] + vec.z * mtx[9] + mtx[13],
                  vec.x * mtx[2] + vec.y * mtx[6] + vec.z * mtx[10] + mtx[14]);
}
