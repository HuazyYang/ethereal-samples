if(BUILD_TESTING AND NOT TARGET gvdb_owned_view_tests)
    add_executable(gvdb_owned_view_tests "${CMAKE_CURRENT_LIST_DIR}/OwnedVolumeViewTests.cpp")
    target_link_libraries(gvdb_owned_view_tests PRIVATE gvdb_volume_viewer)
    ethereal_use_agility_sdk(gvdb_owned_view_tests)
    if(NVRHI_WITH_CUDA)
        target_link_libraries(gvdb_owned_view_tests PRIVATE nvrhi::cuda)
        target_compile_definitions(gvdb_owned_view_tests PRIVATE ETHEREAL_TEST_CUDA=1)
    endif()
    foreach(api DX11 DX12 VULKAN CUDA)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(argument -vk)
            elseif(api STREQUAL "DX11")
                set(argument -dx11)
            elseif(api STREQUAL "DX12")
                set(argument -dx12)
            else()
                set(argument -cuda)
            endif()
            add_test(NAME gvdb_owned_view_${api} COMMAND gvdb_owned_view_tests ${argument})
            set_tests_properties(gvdb_owned_view_${api} PROPERTIES TIMEOUT 120)
        endif()
    endforeach()
endif()
