# Public graphics export -> CUDA compute -> graphics readback, with no native SDK calls.
if(NVRHI_WITH_CUDA AND TARGET nvrhi::interop)
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/interop-texture.cfg"
        CONTENT "\"${CMAKE_CURRENT_SOURCE_DIR}/InteropTexture.slang\" -T cs -E updateShared\n" @ONLY)
    shadertool_add_shader_objects(TARGET slang_interop_shaders CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/interop-texture.cfg"
        BACKENDS SLANG-PTX ARTIFACT OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/interop")
    add_executable(slang_graphics_interop_tests InteropTests.cpp)
    target_link_libraries(slang_graphics_interop_tests PRIVATE donut_app nvrhi::interop nvrhi::cuda)
    add_dependencies(slang_graphics_interop_tests slang_interop_shaders)
    ethereal_use_agility_sdk(slang_graphics_interop_tests)
    foreach(api DX11 DX12 VULKAN)
        if(NVRHI_WITH_${api})
            if(api STREQUAL "VULKAN")
                set(argument -vk)
            elseif(api STREQUAL "DX11")
                set(argument -dx11)
            else()
                set(argument -dx12)
            endif()
            add_test(NAME slang_graphics_interop_${api} COMMAND slang_graphics_interop_tests ${argument})
            set_tests_properties(slang_graphics_interop_${api} PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77)
        endif()
    endforeach()
endif()
