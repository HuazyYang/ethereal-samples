# Native fixed-array ABI regression. Include after donut_app and ShaderTool helpers.
set(resource_array_backends)
if(NVRHI_WITH_DX12)
    list(APPEND resource_array_backends SLANG-DXIL)
endif()
if(NVRHI_WITH_VULKAN)
    list(APPEND resource_array_backends SLANG-SPIRV)
endif()
if(NVRHI_WITH_OPTIX)
    list(APPEND resource_array_backends SLANG-OPTIX)
endif()
if(resource_array_backends)
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/resource-arrays.cfg"
        CONTENT "\"${CMAKE_CURRENT_LIST_DIR}/ResourceArrays.slang\" -T lib\n" @ONLY)
    shadertool_add_shader_objects(TARGET slang_resource_arrays_shaders
        CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/resource-arrays.cfg"
        BACKENDS ${resource_array_backends} ARTIFACT
        INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/../../../gvdb_samples/gvdb/slang"
        OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/resource_arrays"
        EXTRA_FLAGS_OPTIX "-I" "${NVRHI_OPTIX_INCLUDE_DIR}")
    add_executable(slang_resource_arrays "${CMAKE_CURRENT_LIST_DIR}/ResourceArrays.cpp")
    target_link_libraries(slang_resource_arrays PRIVATE donut_app)
    add_dependencies(slang_resource_arrays slang_resource_arrays_shaders)
    ethereal_use_agility_sdk(slang_resource_arrays)
    foreach(api DX12 VULKAN CUDA)
        if(api STREQUAL "CUDA")
            if(NOT NVRHI_WITH_OPTIX)
                continue()
            endif()
            target_compile_definitions(slang_resource_arrays PRIVATE ETHEREAL_TEST_CUDA=1)
            target_link_libraries(slang_resource_arrays PRIVATE nvrhi::cuda)
            set(argument -cuda)
            set(kind optix)
        elseif(api STREQUAL "VULKAN")
            if(NOT NVRHI_WITH_VULKAN)
                continue()
            endif()
            set(argument -vk)
            set(kind spirv)
        else()
            if(NOT NVRHI_WITH_DX12)
                continue()
            endif()
            set(argument -dx12)
            set(kind dxil)
        endif()
        add_test(NAME slang_resource_arrays_${api} COMMAND slang_resource_arrays ${argument}
            "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/shaders/resource_arrays/${kind}/ResourceArrays.bin")
        set_tests_properties(slang_resource_arrays_${api} PROPERTIES TIMEOUT 90 SKIP_RETURN_CODE 77)
    endforeach()
endif()
