// Resources of Asteroids.exe, rebuilt from the original resource section:
// DIALOGEX 101 (dumped control by control), ICON group 106 (6 images, 16..256 px) and BITMAP 107
// extracted unchanged into res/, and the VERSIONINFO strings.

#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_ASTEROIDS   ICON    "res/asteroids.ico"
IDB_BANNER      BITMAP  "res/banner.bmp"

IDD_STARTUP DIALOGEX 0, 0, 331, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NVIDIA Asteroids Demo"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         IDB_BANNER, IDC_BANNER, "Static", SS_BITMAP | SS_REALSIZEIMAGE, 7, 7, 317, 103
    LTEXT           "Resolution", IDC_STATIC, 96, 122, 34, 8
    COMBOBOX        IDC_RESOLUTION, 134, 119, 80, 30, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Full screen", IDC_FULLSCREEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 134, 136, 50, 10
    CONTROL         "Run benchmark", IDC_BENCHMARK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 134, 149, 65, 10
    DEFPUSHBUTTON   "Start", IDOK, 216, 160, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 274, 160, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NVIDIA Corporation"
            VALUE "FileDescription", "NVIDIA Asteroids Demo Application (master-905edaa)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", "(C) 2018 NVIDIA Corporation. All rights reserved."
            VALUE "OriginalFilename", "Asteroids.exe"
            VALUE "ProductName", "NVIDIA Asteroids Demo"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
